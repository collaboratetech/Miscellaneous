# Required: your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: server port (default 4000)
PORT=4000

# Optional: comma-separated allowed origins for CORS
# Default allows the dev task pane at https://localhost:3000
ALLOWED_ORIGINS=https://localhost:3000

# Optional: shared bearer token the task pane must send in Authorization: Bearer <token>
# Leave empty in dev to disable auth. REQUIRED in production.
SHARED_AUTH_TOKEN=

# Optional: use HTTP instead of HTTPS (default HTTPS using office-addin-dev-certs)
# Set to "true" only behind a TLS-terminating proxy.
USE_HTTP=false
